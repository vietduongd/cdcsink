NATS_URL=nats://localhost:4222
NATS_CONSUMER_NAME=cdcsink_demo02
NATS_STREAM_NAME=CDC
NATS_PULL_NUMBER_OBJECT=10000
TOPIC_NAME=debezium.>
DATABASE_URL=postgres://postgres:Nintendo123@localhost:5432/receive_sync
DATABASE_SCHEMA_EXPECT=public
# Bật lọc cột/dòng theo table: copy sync_config.example.yaml thành sync_config.yaml, sửa theo nhu cầu rồi bỏ comment dòng dưới.
# SYNC_CONFIG_PATH=./sync_config.yaml
# Log: mức log theo RUST_LOG (mặc định info,sqlx=warn,async_nats=warn); LOG_FORMAT=json để xuất JSON.
# RUST_LOG=info
# LOG_FORMAT=json
# Số lần retry khi ghi batch vào DB đích lỗi (backoff 1s, 2s, 4s...). Hết lượt thì thoát mã 1, batch chưa ack sẽ được gửi lại sau khi khởi động lại.
# MAX_BATCH_RETRIES=5
# Chu kỳ (giây) replay dữ liệu lỗi được đánh dấu retry trong _cdc_dead_letter; 0 để tắt.
#   UPDATE _cdc_dead_letter SET status = 'retry' WHERE status = 'pending' AND table_name = 'users';
# DEAD_LETTER_REPLAY_SECS=30
# Thời gian (giây) NATS chờ ack trước khi gửi lại message; cdcsink tự gia hạn trong lúc xử lý batch.
# NATS_ACK_WAIT_SECS=30
